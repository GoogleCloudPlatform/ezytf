# ==============================================================================
# ezytf Environment Configuration
# ==============================================================================
# Copy this file to .env and update the values to match your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# GCP & Deployment Settings (used by Makefile)
# ------------------------------------------------------------------------------
# Google Cloud Project ID
GCP_PROJECT_ID=gcp-project-id

# GCP Region for Cloud Run and Artifact Registry
GCP_REGION=us-central1

# Artifact Registry / Container Registry image path (without tag)
IMAGE_REPO=us-docker.pkg.dev/gcp-project-id/ezy/ezytf

# Image tag for build, push, and deploy
IMAGE_TAG=latest

# Cloud Run Service Name
CLOUD_RUN_SERVICE=ezytf

# Cloud Run Job Name
CLOUD_RUN_JOB=gcp-ezytf

# Cloud Run Service Account (optional, leave blank for default)
CLOUD_RUN_SA=

# ------------------------------------------------------------------------------
# Local & Docker Runtime Settings (used by Makefile & ezytf)
# ------------------------------------------------------------------------------
# Local port to expose when running in Docker or locally in service mode
PORT=8080

# Local port to map on host when running in Docker (e.g. -p $(HOST_PORT):$(PORT))
HOST_PORT=8080

# Path to Application Default Credentials (ADC) on host
ADC_PATH=$(HOME)/.config/gcloud/application_default_credentials.json

# ------------------------------------------------------------------------------
# ezytf Application Configuration
# ------------------------------------------------------------------------------
# ezytf Mode: 'service' (Cloud Function / HTTP) or 'generate_job' (script)
EZTF_MODE=service

# Google Sheet ID (required for sheet-based generation)
EZTF_SHEET_ID=

# Source Manager / Git Host URL
EZTF_SSM_HOST=https://INSTANCE_NAME-PROJECT_NUMBER.asia-east1.sourcemanager.dev

# Source Manager GCP Project (if different from GCP_PROJECT_ID)
EZTF_SSM_PROJECT=

# GCS Bucket for input configs (Cloud Run / Cloud Function mode)
EZTF_CONFIG_BUCKET=

# GCS Bucket for output (Cloud Run / Cloud Function mode)
EZTF_OUTPUT_BUCKET=

# Local directory for config files (default: ../ezytf-gen-data/eztf-config)
EZTF_CONFIG_DIR=../ezytf-gen-data/eztf-config

# Local directory for generated output (default: ../ezytf-gen-data/eztf-output)
EZTF_OUTPUT_DIR=../ezytf-gen-data/eztf-output

# Path to SSH private key file on host (optional, for git operations)
EZTF_SSH_PVT_FILE=

# SSH private key content (optional, for git operations)
EZTF_SSH_PVT_KEY=
